{
 "name": "lit-club-cms-preview",
 "main": "server/worker.mjs",
 "compatibility_date": "2026-10-12",
 "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
 "d1_databases": [{"binding":"DB","database_name":"lit-club-cms-preview","database_id":"REPLACE_AFTER_APPROVAL","migrations_dir":"migrations"}]
 // Add PDFS R2 binding only after account setup is approved.
 // MEMBER_PASSWORD, ADMIN_PASSWORD (distinct, at least 16 characters),
 // SESSION_SECRET (at least 32 characters) must be Worker secrets.
}
