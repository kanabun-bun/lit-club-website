{
 "name": "lit-club-cms-preview",
 "main": "server/worker.mjs",
 "compatibility_date": "2026-10-12",
 "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
 "vars": {
  "CMS_BACKEND": "github",
  "GITHUB_DATA_REPO": "REPLACE_OWNER/REPLACE_PRIVATE_DATA_REPO",
  "GITHUB_DATA_BRANCH": "main",
  "MAX_ACTIVE_PDF_BYTES": "256000000"
 },
 "ratelimits": [
  {"name":"LOGIN_LIMITER","namespace_id":"1001","simple":{"limit":5,"period":60}},
  {"name":"API_LIMITER","namespace_id":"1002","simple":{"limit":60,"period":60}}
 ]
 // Worker secrets: GITHUB_TOKEN, MEMBER_PASSWORD, ADMIN_PASSWORD, SESSION_SECRET.
 // No D1, R2 or KV bindings. Keep the private data repo separate from source.
 // Start as a separate preview Worker; change the production name only after QA.
}
