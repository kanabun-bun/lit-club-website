{
  "name": "lit-club-website",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "CMS_BACKEND": "github",
    "GITHUB_DATA_REPO": "kanabun-bun/lit-club-data",
    "GITHUB_DATA_BRANCH": "main",
    "MAX_ACTIVE_PDF_BYTES": "256000000"
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
